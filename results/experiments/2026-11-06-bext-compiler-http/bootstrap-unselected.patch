+// Cache one immutable compiler bootstrap, never a rendered response. The
+// generated wrapper passes the same script on each request. A one-entry cache
+// is bounded and switches immediately when a different wrapper is evaluated.
+let previousIslandLoader: string | undefined;
+let normalizedIslandLoader: string | undefined;
+function normalizeIslandLoader(rawIslandLoaderHtml: string | undefined): string | undefined {
+  if (rawIslandLoaderHtml === previousIslandLoader) return normalizedIslandLoader;
+  // Client navigation must replay the bootstrap outside <main>, while
+  // persistent layout scripts run only once.
