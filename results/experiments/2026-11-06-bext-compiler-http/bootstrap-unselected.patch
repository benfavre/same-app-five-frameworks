+import { expect, test } from "bun:test";
+import { runRoute } from "./prism-runtime";
+import { safe } from "./jsx";
+
+test("reused compiler bootstrap preserves fresh HTML and disposes listeners on every browser replay", async () => {
+  let renders = 0;
+  const envelope = () => ({ params: {}, searchParams: {}, request: {
+    url: "https://fixture.invalid/", method: "GET", headers: {}, body: null,
+  } });
+  const render = async (islandLoaderHtml?: string) => {
+    const result = await runRoute({
+      Page: () => safe(`<html><head></head><body><p>${++renders}</p><bext-island data-component="Probe"></bext-island></body></html>`),
+      layouts: [], envelope: envelope(), dynamic: "force-dynamic", islandLoaderHtml,
+    });
+    if (result.kind !== "html") throw new Error("expected HTML");
+    return result.body;
+  };
+  const a = '<script>document.addEventListener("click",function(){window.probe="A";});</script>';
+  const b = '<script>document.addEventListener("focus",function(){window.probe="B";});</script>';
+  const script = (html: string) => html.match(/<script data-bext-island-loader>([\s\S]*?)<\/script>/)![1];
+  const first = await render(a), second = await render(a), changed = await render(b), again = await render(a);
+  expect(first).toContain("<p>1</p>"); expect(second).toContain("<p>2</p>");
+  expect(script(second)).toBe(script(first)); expect(script(again)).toBe(script(first));
+  expect(script(changed)).not.toBe(script(first));
+  const listeners = new Map<string, Function>();
+  const window: any = {};
+  const document = {
+    addEventListener(type: string, handler: Function) { listeners.set(type, handler); },
+    removeEventListener(type: string, handler: Function) { if (listeners.get(type) === handler) listeners.delete(type); },
+  };
+  for (const [html, type, marker] of [[first, "click", "A"], [second, "click", "A"], [changed, "focus", "B"], [again, "click", "A"]]) {
+    new Function("window", "document", script(html))(window, document);
+    expect(listeners.size).toBe(1); expect(listeners.has(type)).toBe(true);
+    listeners.get(type)!(); expect(window.probe).toBe(marker);
+  }
+  expect(await render()).not.toContain("data-bext-island-loader");
+  expect(await render('<script data-custom>window.custom=1;</script>')).toContain('<script data-custom>window.custom=1;</script>');
+  expect(script(await render(a))).toBe(script(first));
+});
